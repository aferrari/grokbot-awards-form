# Your own Neon Postgres connection string. Never commit a real value.
DATABASE_URL=postgres://user:password@your-neon-host/db?sslmode=require

# Shared secret for /setup, POST /api/quiz, and POST /api/voters.
# Generate a long random string. If this is unset, those actions are rejected.
ADMIN_SECRET=replace-with-a-long-random-string
